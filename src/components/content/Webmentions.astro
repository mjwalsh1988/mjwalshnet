---
// Webmentions under a post: likes and reposts as counts, replies and mentions
// as a list. Rendered at build from webmention.io; empty when there are none.
import { formatDate } from "../../lib/content";
import type { Mention } from "../../lib/webmentions";

interface Props {
  mentions: Mention[];
}
const { mentions } = Astro.props;
const likes = mentions.filter((m) => m.type === "like").length;
const reposts = mentions.filter((m) => m.type === "repost").length;
const replies = mentions.filter((m) => m.type === "reply" || m.type === "mention");
---

{mentions.length > 0 && (
  <section class="mentions" aria-labelledby="mentions-title">
    <h2 id="mentions-title" class="mentions__title">
      Mentions from around the web
    </h2>
    <p class="mentions__counts">
      {likes > 0 && (
        <span>
          {likes} like{likes === 1 ? "" : "s"}
        </span>
      )}
      {reposts > 0 && (
        <span>
          {reposts} repost{reposts === 1 ? "" : "s"}
        </span>
      )}
      {replies.length > 0 && (
        <span>
          {replies.length} {replies.length === 1 ? "reply" : "replies"}
        </span>
      )}
    </p>
    {replies.length > 0 && (
      <ul class="mentions__list">
        {replies.map((m) => (
          <li class="mentions__item">
            <p class="eyebrow">
              {m.author.url ? <a href={m.author.url}>{m.author.name}</a> : m.author.name}
              {m.published && (
                <time datetime={m.published}>{formatDate(new Date(m.published))}</time>
              )}
            </p>
            {m.content && <p>{m.content}</p>}
            <p>
              <a href={m.url}>Read it at the source</a>
            </p>
          </li>
        ))}
      </ul>
    )}
  </section>
)}

<style>
  .mentions {
    max-width: var(--measure);
  }
  .mentions__title {
    font-size: var(--step-2);
  }
  .mentions__counts {
    margin-top: var(--space-2);
    display: flex;
    gap: var(--space-4);
    color: var(--fg-muted);
  }
  .mentions__list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }
  .mentions__item {
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    display: grid;
    gap: var(--space-2);
  }
  .mentions__item .eyebrow {
    display: flex;
    gap: var(--space-4);
  }
</style>
