---
// Wraps rendered Markdown. Sets the measure, the vertical rhythm and the
// styles for everything the MDX pipeline emits: headings with anchors,
// lists, tables, blockquotes, footnotes, code and images.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["prose", className]}>
  <slot />
</div>

<style is:global>
  .prose {
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: var(--leading-body);
  }
  .prose > * + * {
    margin-top: var(--space-5);
  }
  .prose > h2 {
    margin-top: var(--space-8);
  }
  .prose > h3 {
    margin-top: var(--space-7);
  }
  .prose > h4 {
    margin-top: var(--space-6);
  }
  .prose h2,
  .prose h3,
  .prose h4 {
    position: relative;
    scroll-margin-top: var(--space-6);
  }
  .prose h2 + *,
  .prose h3 + *,
  .prose h4 + * {
    margin-top: var(--space-4);
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }
  .prose li + li {
    margin-top: var(--space-2);
  }
  .prose ul ul,
  .prose ol ol,
  .prose ul ol,
  .prose ol ul {
    margin-top: var(--space-2);
  }
  .prose strong {
    font-weight: 700;
  }
  .prose blockquote {
    margin: var(--space-6) 0;
    padding-left: var(--space-5);
    border-left: 3px solid var(--accent);
    color: var(--fg);
  }
  .prose blockquote > * + * {
    margin-top: var(--space-3);
  }
  .prose hr {
    margin: var(--space-7) auto;
    width: 4rem;
  }
  .prose code:not(pre code) {
    padding: 0.1em 0.35em;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    font-size: 0.9em;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    display: block;
    overflow-x: auto;
  }
  .prose caption {
    text-align: left;
    font-weight: 600;
    padding-bottom: var(--space-2);
  }
  .prose th,
  .prose td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .prose th {
    font-weight: 700;
    border-bottom-width: 2px;
  }
  .prose img {
    border-radius: 2px;
  }
  .prose figure {
    margin: var(--space-6) 0;
  }
  .prose figcaption {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .prose .footnotes {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .prose .footnotes h2 {
    font-size: var(--step-1);
    margin-top: 0;
  }
  .prose sup a {
    text-decoration: none;
    padding-inline: 0.1em;
  }
  .prose kbd {
    padding: 0.1em 0.4em;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 3px;
    font-size: 0.85em;
    background: var(--bg-surface);
  }
  .prose .expressive-code {
    margin: var(--space-6) 0;
  }

  /* Heading anchors: the heading text is the link, in the text color, with a
     small mark that appears on hover or focus so the link is discoverable. */
  .heading-anchor {
    color: inherit;
    text-decoration: none;
  }
  .heading-anchor:hover,
  .heading-anchor:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }
  .heading-anchor::after,
  .heading-anchor--after::before {
    content: "#";
    margin-left: 0.35em;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.7em;
    opacity: 0;
  }
  .heading-anchor--after::after {
    content: none;
  }
  .heading-anchor:hover::after,
  .heading-anchor:focus-visible::after,
  .heading-anchor--after:hover::before,
  .heading-anchor--after:focus-visible::before {
    opacity: 1;
  }
</style>
