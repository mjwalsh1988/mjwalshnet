---
// An image with alt text, an optional caption, and a long description under
// "Describe this image" when the image carries information. Uses Astro's
// Picture component for AVIF and WebP with explicit dimensions. The
// disclosure sits after the figure (a figcaption must be the first or last
// child of its figure) and the image points at it with aria-details.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Describe from "./Describe.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  longDescription?: string;
  /** Above-the-fold image: eager loading and high fetch priority. */
  priority?: boolean;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const {
  src,
  alt,
  caption,
  longDescription,
  priority = false,
  widths = [480, 800, 1200, 1600],
  sizes = "(min-width: 72rem) 65rem, calc(100vw - 2rem)",
  class: className,
} = Astro.props;

function hash(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i += 1) h = (h * 31 + s.charCodeAt(i)) | 0;
  return h;
}
const describeId = longDescription
  ? `describe-${Math.abs(hash(alt + (caption ?? "")))}`
  : undefined;
const candidateWidths = widths.filter((w) => w <= src.width);
---

<div class:list={["figure", className]}>
  <figure class="figure__figure">
    <Picture
      src={src}
      alt={alt}
      widths={candidateWidths.length ? candidateWidths : [src.width]}
      sizes={sizes}
      formats={["avif", "webp"]}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding={priority ? "sync" : "async"}
      aria-details={describeId}
    />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
  {longDescription && <Describe text={longDescription} id={describeId} />}
</div>

<style>
  .figure__figure {
    margin: 0;
  }
</style>
