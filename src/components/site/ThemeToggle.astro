---
// The theme switch. The label and icon name what the button does next, so a
// sighted visitor sees it change and a screen reader hears "Switch to light
// theme, button". Both labels are in the markup and CSS shows the one that
// matches data-theme on <html>, which the inline preference script sets before
// first paint, so the label is right from the first frame. Without JavaScript
// the button stays hidden and the page shows the light theme.
---

<button type="button" class="theme-toggle" data-theme-toggle data-pending>
  <span class="theme-toggle__label theme-toggle__label--to-dark">
    <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
      <path
        d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      ></path>
    </svg>
    <span>Switch to dark theme</span>
  </span>
  <span class="theme-toggle__label theme-toggle__label--to-light">
    <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
      <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path
        d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      ></path>
    </svg>
    <span>Switch to light theme</span>
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-primary);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: 2px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .theme-toggle__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  /* display: none also drops the hidden label from the accessible name. */
  .theme-toggle__label--to-light,
  :global(:root[data-theme="dark"]) .theme-toggle__label--to-dark {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle__label--to-light {
    display: inline-flex;
  }
</style>

<script>
  import { announce } from "../../lib/ui/announce";
  import {
    applyPrefs,
    readPrefs,
    resolvedTheme,
    syncThemeColor,
    writePrefs,
    PREFS_EVENT,
    PREFS_KEY,
  } from "../../lib/prefs";

  syncThemeColor(resolvedTheme(readPrefs()));

  // A switch in another tab, or a page restored from the back-forward cache,
  // leaves this page painted with stale prefs. Re-apply them so the page, the
  // label and the reading controls match storage again.
  function resync() {
    const prefs = readPrefs();
    applyPrefs(prefs);
    document.dispatchEvent(new CustomEvent(PREFS_EVENT, { detail: prefs }));
  }
  window.addEventListener("storage", (event) => {
    if (event.key === PREFS_KEY || event.key === null) resync();
  });
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) resync();
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.removeAttribute("data-pending");
    button.addEventListener("click", () => {
      // Go from what the page shows, which is what the label promises.
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      writePrefs({ theme: next });
      // Screen readers do not always read a changed name on the focused button.
      announce(next === "dark" ? "Dark theme on." : "Light theme on.");
      if (next === "dark") window.mwTrack?.("theme_dark");
    });
  }
</script>
