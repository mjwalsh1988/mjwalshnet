---
// The access bar: a strip above the header row with every tool for reading
// the site in one place, on every page. Search opens the palette, the theme
// switch flips light and dark, Reading opens the reading and display settings,
// and Screen reader view shows the page as my screen reader reads it. The
// items share the nav's type so they read as part of the site, not add-ons.
import ThemeToggle from "./ThemeToggle.astro";
---

<div class="access-bar">
  <div class="wrap access-bar__row">
    <button type="button" class="access-bar__item" data-palette-open>
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
        <circle
          cx="6.5"
          cy="6.5"
          r="4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        ></circle>
        <path d="M10 10l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <span>Search</span>
      <kbd class="access-bar__kbd" aria-hidden="true">
        /
      </kbd>
    </button>
    <ThemeToggle />
    <button type="button" class="access-bar__item" data-dialog-open="reading-controls" data-pending>
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
        <path
          d="M1.5 13L4.5 3.5h1L8.5 13M2.6 9.8h4.8M10 8.6c.5-.8 1.3-1.1 2.1-1.1 1.4 0 2.2.8 2.2 2.1V13M14.3 10.8c-2.6 0-4.1.5-4.1 1.3 0 .6.5 1 1.3 1 1.4 0 2.8-.9 2.8-2.3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      <span>Reading</span>
    </button>
    <button type="button" class="access-bar__item" data-sr-view-open data-pending>
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
        <path
          d="M2 6h2.5L8 3v10l-3.5-3H2zM10.5 5.5a3.5 3.5 0 0 1 0 5M12.5 3.5a6.3 6.3 0 0 1 0 9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      <span>
        Screen reader<span class="access-bar__long"> view</span>
      </span>
    </button>
  </div>
</div>

<style>
  .access-bar {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .access-bar__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 var(--space-4);
  }
  /* :global so the theme switch, which is its own component, shares the look. */
  .access-bar :global(.access-bar__item) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-primary);
    padding: 0 var(--space-1);
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .access-bar :global(.access-bar__item:hover) {
    border-bottom-color: var(--accent);
  }
  .access-bar__kbd {
    padding: 0 0.4em;
    border: 1px solid var(--border);
    border-radius: 2px;
    font-size: 0.85em;
    color: var(--fg-muted);
    text-transform: none;
  }
  /* On a phone the four labels do not fit one row, so they sit in a two by two
     grid. The shortcut hint needs a keyboard anyway. */
  @media (width < 40rem) {
    .access-bar__row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 var(--space-2);
    }
    .access-bar :global(.access-bar__item) {
      justify-content: flex-start;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    /* Out of sight but still in the name, so a screen reader hears the whole label. */
    .access-bar__long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .access-bar__kbd {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .access-bar {
      border-bottom: 1px solid CanvasText;
    }
  }
</style>
