---
// The mark: braille cells for M (dots 1, 3, 4) and W (dots 2, 4, 5, 6) as a
// six-dot grid each. Decorative by default (the header link carries the name);
// pass a label to make it an image with a name.
interface Props {
  size?: number;
  label?: string;
  class?: string;
}
const { size = 28, label, class: className } = Astro.props;
const height = Math.round(size * (30 / 44));

// Dot positions: left column 1, 2, 3 top to bottom; right column 4, 5, 6.
const cell = (x: number, dots: number[]) =>
  [1, 2, 3, 4, 5, 6].map((n) => ({
    cx: n <= 3 ? x : x + 10,
    cy: 5 + ((n - 1) % 3) * 10,
    on: dots.includes(n),
  }));
const dots = [...cell(6, [1, 3, 4]), ...cell(28, [2, 4, 5, 6])];
---

<svg
  class={className}
  width={size}
  height={height}
  viewBox="0 0 44 30"
  role={label ? "img" : undefined}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  focusable="false"
>
  {dots.map((d) => (
    <circle cx={d.cx} cy={d.cy} r={d.on ? 4 : 1.4} fill="currentColor" opacity={d.on ? 1 : 0.35} />
  ))}
</svg>
