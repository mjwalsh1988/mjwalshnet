---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
---

<Base title={SITE.name} description={SITE.description} path="/">
  <section class="wrap" style="padding-block: var(--space-8);">
    <p class="eyebrow">Scaffold</p>
    <h1>Michael Walsh</h1>
    <p class="measure" style="margin-top: var(--space-4);">
      The home page is built in Phase 3. This page exists so the layout, the header, the footer and
      the preference controls can be tested first.
    </p>
  </section>
</Base>
