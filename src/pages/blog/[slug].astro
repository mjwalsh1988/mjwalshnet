---
import Post from "../../layouts/Post.astro";
import { getPosts, type Post as PostEntry } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, allPosts: posts } }));
}

interface Props {
  post: PostEntry;
  allPosts: PostEntry[];
}
const { post, allPosts } = Astro.props;
---

<Post post={post} allPosts={allPosts} />
