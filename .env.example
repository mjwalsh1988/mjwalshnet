# Copy to .env for local work. Production values live in the Vercel project.
# Every feature below runs without its key: the code detects the missing value,
# logs one line, and falls back (see docs/handoff.md for what each fallback does).

# Supabase (project ref kavssklkhapzsdvkuwii). New key names only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Contact form mail through Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile on the contact form. The site key is public.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Newsletter through Buttondown.
BUTTONDOWN_API_KEY=

# Metrics job: Google Search Console service account (the whole JSON on one line).
GSC_SERVICE_ACCOUNT_JSON=

# Vercel cron bearer token and the production deploy hook the metrics job posts to.
CRON_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# IndexNow key; the matching key file is served from /public.
INDEXNOW_KEY=

# Public values.
PUBLIC_SITE_URL=https://mjwalsh.net
PUBLIC_GA_MEASUREMENT_ID=G-1HNN2M5MQ1
